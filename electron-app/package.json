{
  "name": "zyztools-test",
  "version": "1.2.12",
  "zyzBuildChannel": "test",
  "displayName": "ZYZTools test",
  "description": "ZYZTools EuroScope controller tools and plugin installer",
  "author": "Charlie Yablon and Elliot Potts",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "node build-channel.cjs test",
    "dist:production": "node build-channel.cjs production",
    "dist:both": "node build-channel.cjs both"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zyztools.test",
    "productName": "ZYZTools test",
    "artifactName": "ZYZTools-Setup.${ext}",
    "directories": {
      "output": "../installer/dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../build/TestSourceSnapshot.json", "to": "TestSourceSnapshot.json" },
      {
        "from": "../build",
        "to": "plugin",
        "filter": [
          "PreferredCYYZPdcPlugin.dll",
          "PreferredCYYZPdcBridge.exe",
          "PreferredCYYZAudioReplay.exe",
          "EuroScopePlugInDll.dll",
          "PreferredCYYZPdcPlugin.json",
          "PDCBridge.ini",
          "pdc_request.wav",
          "cpdlc_rx.wav",
          "IFR_release.wav",
          "DEPARTURE_LIST_SETUP.md"
        ]
      },
      {
        "from": "../installer/CHANGELOG.md",
        "to": "plugin/CHANGELOG.md"
      },
      {
        "from": "../README.md",
        "to": "plugin/README.md"
      },
      {
        "from": "../build/TrackAudioTap140/out/afv_native.dll",
        "to": "plugin/TrackAudioTap-1.4.0-afv_native.dll"
      },
      {
        "from": "../build/TrackAudioTap/out/afv_native.dll",
        "to": "plugin/TrackAudioTap-1.4.0-beta.6-afv_native.dll"
      },
      {
        "from": "../build/TrackAudioTapStable/out/afv_native.dll",
        "to": "plugin/TrackAudioTap-1.3.3-afv_native.dll"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZYZTools test"
    }
  }
}
