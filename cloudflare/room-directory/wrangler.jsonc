{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zyztools-room-directory-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITERS", "class_name": "ClientLimiter" },
      { "name": "APP_POLICY", "class_name": "AppPolicy" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "ClientLimiter"] }, { "tag": "v2-app-policy", "new_sqlite_classes": ["AppPolicy"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
